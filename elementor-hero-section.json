{
  "version": "0.4",
  "title": "Tropic Hiking Trails - Hero Section",
  "type": "section",
  "content": [
    {
      "id": "hero_section_container",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "background_background": "classic",
        "background_color": "#0C6B4F",
        "padding": {
          "unit": "px",
          "top": "60",
          "right": "20",
          "bottom": "60",
          "left": "20",
          "isLinked": false
        }
      },
      "elements": [
        {
          "id": "hero_column",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "hero_heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Hiking Adventures",
                "header_size": "h1",
                "align": "center",
                "title_color": "#FFFFFF",
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 36
                },
                "typography_font_weight": "700"
              }
            },
            {
              "id": "hero_subheading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Find your next trail with MyRehat",
                "header_size": "p",
                "align": "center",
                "title_color": "#E0E0E0",
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 18
                }
              }
            },
            {
              "id": "hero_search_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"text-align: center; margin-top: 18px;\"><input id=\"main-search\" type=\"text\" placeholder=\"Search homepage...\" style=\"padding: 10px 14px; font-size: 15px; width: min(420px, 90%); border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;\"></div>"
              }
            }
          ]
        }
      ]
    }
  ]
}